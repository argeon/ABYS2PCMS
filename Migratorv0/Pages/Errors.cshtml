@page
@model Migratorv0.Pages.ErrorsModel
@{
    ViewData["Title"] = "Error Analysis";
}

<style>
    .errors-metric-card .stat-number {
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }
    .errors-metric-card .card-body {
        min-height: 5.5rem;
    }
    .errors-chart-wrap {
        min-height: 260px;
    }
</style>

<div class="container-fluid mt-2 mb-3 px-3">
    <div class="row mb-2">
        <div class="col-12">
            <h4 class="mb-0">
                <i class="fas fa-exclamation-triangle text-danger"></i>
                Hata Analizi
            </h4>
            <p class="text-muted small mb-0">Migration hatalarını analiz edin ve sorun giderin</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="row g-2 mb-2 align-items-end">
        <div class="col-6 col-lg-3">
            <label for="runFilter" class="form-label small mb-0">Migration Run</label>
            <select id="runFilter" class="form-select form-select-sm">
                <option value="">Tüm Run'lar</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label for="tableFilter" class="form-label small mb-0">Tablo</label>
            <select id="tableFilter" class="form-select form-select-sm">
                <option value="">Tüm Tablolar</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label for="errorTypeFilter" class="form-label small mb-0">Hata Tipi</label>
            <select id="errorTypeFilter" class="form-select form-select-sm">
                <option value="">Tüm Tipler</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label for="resolvedFilter" class="form-label small mb-0">Durum</label>
            <select id="resolvedFilter" class="form-select form-select-sm">
                <option value="">Tümü</option>
                <option value="false">Çözülmemiş</option>
                <option value="true">Çözülmüş</option>
            </select>
        </div>
    </div>

    <!-- Error Stats Cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="card border-danger border-2 shadow-sm h-100 errors-metric-card">
                <div class="card-body py-3 px-3">
                    <div class="text-danger fw-semibold mb-2 small text-uppercase" style="letter-spacing: .04em;">
                        <i class="fas fa-exclamation-circle me-1"></i> Toplam hata
                    </div>
                    <p id="totalErrors" class="mb-1 stat-number display-6 fw-bold text-dark">0</p>
                    <p id="totalErrorsSub" class="mb-0 small text-muted">—</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-warning border-2 shadow-sm h-100 errors-metric-card">
                <div class="card-body py-3 px-3">
                    <div class="text-warning-emphasis fw-semibold mb-2 small text-uppercase" style="letter-spacing: .04em;">
                        <i class="fas fa-hourglass-half me-1"></i> Çözülmemiş
                    </div>
                    <p id="unresolvedErrors" class="mb-1 stat-number display-6 fw-bold text-dark">0</p>
                    <p id="unresolvedErrorsSub" class="mb-0 small text-muted">—</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-success border-2 shadow-sm h-100 errors-metric-card">
                <div class="card-body py-3 px-3">
                    <div class="text-success fw-semibold mb-2 small text-uppercase" style="letter-spacing: .04em;">
                        <i class="fas fa-check-circle me-1"></i> Çözülmüş
                    </div>
                    <p id="resolvedErrors" class="mb-1 stat-number display-6 fw-bold text-dark">0</p>
                    <p id="resolvedErrorsSub" class="mb-0 small text-muted">—</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-info border-2 shadow-sm h-100 errors-metric-card">
                <div class="card-body py-3 px-3">
                    <div class="text-info fw-semibold mb-2 small text-uppercase" style="letter-spacing: .04em;">
                        <i class="fas fa-table me-1"></i> Etkilenen tablo
                    </div>
                    <p id="affectedTables" class="mb-1 stat-number display-6 fw-bold text-dark">0</p>
                    <p id="affectedTablesSub" class="mb-0 small text-muted">—</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Type Distribution Chart -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-2 px-3 border-bottom">
                    <span class="fw-semibold">Hata tipi dağılımı</span>
                    <span class="text-muted small ms-2 d-none d-md-inline">(adet ve oran)</span>
                </div>
                <div class="card-body p-3">
                    <div class="position-relative errors-chart-wrap">
                        <canvas id="errorTypeChart" aria-label="Hata tipi grafiği"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-2 px-3 border-bottom">
                    <span class="fw-semibold">En çok hata alan tablolar</span>
                    <span class="text-muted small ms-2 d-none d-md-inline">(ilk 5)</span>
                </div>
                <div class="card-body p-3">
                    <div class="position-relative errors-chart-wrap">
                        <canvas id="errorTableChart" aria-label="Tablo başına hata grafiği"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error List -->
    <div class="row g-2">
        <div class="col-12">
            <div class="card">
                <div class="card-header py-2 px-2 d-flex justify-content-between align-items-center flex-wrap gap-1">
                    <span class="small fw-semibold mb-0">Hata Listesi</span>
                    <div>
                        <button class="btn btn-sm btn-primary" onclick="exportErrors()">
                            <i class="fas fa-download"></i> Export CSV
                        </button>
                        <button class="btn btn-sm btn-success" onclick="resolveSelected()">
                            <i class="fas fa-check"></i> Seçilenleri Çözüldü İşaretle
                        </button>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 small" id="errorTable">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectAll"></th>
                                    <th>Zaman</th>
                                    <th>Run ID</th>
                                    <th>Tablo</th>
                                    <th>Partition</th>
                                    <th>Hata Tipi</th>
                                    <th>Mesaj</th>
                                    <th>Retry</th>
                                    <th>Durum</th>
                                    <th>Aksiyon</th>
                                </tr>
                            </thead>
                            <tbody id="errorTableBody">
                                <tr>
                                    <td colspan="10" class="text-center text-muted">
                                        <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Detail Modal -->
<div class="modal fade" id="errorDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hata Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2">
                <div class="row mb-2 small">
                    <div class="col-md-6">
                        <strong>Hata Tipi:</strong> <span id="detailErrorType"></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Oluşma Zamanı:</strong> <span id="detailOccurredAt"></span>
                    </div>
                </div>
                <div class="row mb-2 small">
                    <div class="col-md-4">
                        <strong>Run ID:</strong> <span id="detailRunId"></span>
                    </div>
                    <div class="col-md-4">
                        <strong>Tablo:</strong> <span id="detailTableName"></span>
                    </div>
                    <div class="col-md-4">
                        <strong>Partition ID:</strong> <span id="detailPartitionId"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12 small">
                        <strong>Hata Mesajı:</strong>
                        <pre id="detailErrorMessage" class="bg-light p-2 mt-1 mb-0 border rounded small"></pre>
                    </div>
                </div>
                <div class="row small" id="stackTraceRow">
                    <div class="col-12">
                        <strong>Stack Trace:</strong>
                        <pre id="detailStackTrace" class="bg-light p-2 mt-1 mb-0 border rounded small" style="max-height: 320px; overflow-y: auto;"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-success" onclick="markAsResolved()">
                    <i class="fas fa-check"></i> Çözüldü İşaretle
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/errors.js"></script>
