@page
@model VerifyModel
@{
    ViewData["Title"] = "Table Verification & Comparison";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-check-double"></i> Table Verification & Comparison
            </h2>
            <p class="text-muted">Compare source (Oracle) vs destination (MSSQL) tables before re-migration</p>
        </div>
    </div>

    <!-- Profile Info -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-database"></i> Selected Profile
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Profile Name:</strong> <span id="profileName">-</span></p>
                    <p><strong>Oracle Schema:</strong> <span id="oracleSchema">-</span></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Total Tables:</strong> <span id="totalTables">-</span></p>
                    <p><strong>Last Used:</strong> <span id="lastUsed">-</span></p>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-info" onclick="refreshComparison()">
                    <i class="fas fa-sync"></i> Refresh Comparison
                </button>
                <button class="btn btn-warning" id="dropAllBtn" onclick="dropAllTables()" disabled>
                    <i class="fas fa-trash-alt"></i> Drop All Tables
                </button>
                <button class="btn btn-success" id="retryMigrationBtn" onclick="retryMigration()" disabled>
                    <i class="fas fa-redo"></i> Retry Migration
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center summary-card bg-success text-white">
                <div class="card-body">
                    <h3 id="matchedCount">0</h3>
                    <p class="mb-0">Perfect Match</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center summary-card bg-warning">
                <div class="card-body">
                    <h3 id="mismatchCount">0</h3>
                    <p class="mb-0">Row Mismatch</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center summary-card bg-danger text-white">
                <div class="card-body">
                    <h3 id="missingCount">0</h3>
                    <p class="mb-0">Missing in MSSQL</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center summary-card bg-info text-white">
                <div class="card-body">
                    <h3 id="totalRowDiff">0</h3>
                    <p class="mb-0">Total Difference</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-table"></i> Table Comparison
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-sm" id="comparisonTable">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                            </th>
                            <th>Table Name</th>
                            <th class="text-end">Oracle Rows</th>
                            <th class="text-end">MSSQL Rows</th>
                            <th class="text-end">Difference</th>
                            <th class="text-end">Match %</th>
                            <th>Status</th>
                            <th>Last Check</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="comparisonTableBody">
                        <tr>
                            <td colspan="9" class="text-center">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p>Loading comparison data...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bulk Actions -->
    <div class="card mt-4">
        <div class="card-body">
            <h6>Bulk Actions (Selected Tables)</h6>
            <div class="btn-group" role="group">
                <button class="btn btn-outline-warning" onclick="dropSelectedTables()">
                    <i class="fas fa-trash"></i> Drop Selected
                </button>
                <button class="btn btn-outline-info" onclick="verifySelectedTables()">
                    <i class="fas fa-check"></i> Verify Selected
                </button>
                <button class="btn btn-outline-success" onclick="retrySelectedTables()">
                    <i class="fas fa-redo"></i> Retry Selected
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Table Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/verify.js"></script>
}

<style>
.summary-card {
    transition: transform 0.2s;
}

.summary-card:hover {
    transform: translateY(-5px);
}

.status-matched {
    background-color: #d4edda;
}

.status-mismatch {
    background-color: #fff3cd;
}

.status-missing {
    background-color: #f8d7da;
}
</style>
