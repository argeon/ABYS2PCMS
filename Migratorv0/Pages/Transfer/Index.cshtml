@page "/transfer"
@model MigrationWeb.Pages.Transfer.IndexModel
@{
    ViewData["Title"] = "Transfer Studio";
}

<link href="~/css/transfer.css" rel="stylesheet" />

<div class="transfer-studio">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">MSSQL Transfer Studio</h2>
            <p class="text-muted mb-0">Kaynak MSSQL → hedef MSSQL aktarım tanımları, karşılaştırma ve izleme. Oracle migration’dan bağımsızdır.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card transfer-card h-100">
                <div class="card-body">
                    <h5>3 Aşamalı Pipeline</h5>
                    <p class="text-muted small">Oracle → MSSQL-1 → MSSQL-2 zincir validasyonu ve E2E key kontrolü.</p>
                    <a href="/transfer/pipeline" class="btn btn-primary btn-sm">Pipeline validasyon</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card transfer-card h-100">
                <div class="card-body">
                    <h5>Tanım formları</h5>
                    <p class="text-muted small">Tablo eşleme, bridge key, fazlar, kolon mapping ve validasyon kuralları.</p>
                    <a href="/transfer/recipes" class="btn btn-primary btn-sm">Recipe listesi</a>
                    <a href="/transfer/recipe-edit" class="btn btn-outline-primary btn-sm">Yeni tanım</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card transfer-card h-100">
                <div class="card-body">
                    <h5>Karşılaştırma</h5>
                    <p class="text-muted small">Satır sayısı, bridge eksikleri ve örnek satır içerik diff.</p>
                    <a href="/transfer/compare" class="btn btn-primary btn-sm">Karşılaştırma çalıştır</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card transfer-card h-100">
                <div class="card-body">
                    <h5>İzleme</h5>
                    <p class="text-muted small">Aktarım run’ları, batch log ve checkpoint durumu.</p>
                    <a href="/transfer/monitor" class="btn btn-primary btn-sm">İzleme paneli</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Son recipe’ler</span>
            <button type="button" class="btn btn-sm btn-outline-info" id="btnLoadItUserSample">IT_USER örnek tanımı yükle</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th>Kaynak → Hedef</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="homeRecipeTable">
                        <tr><td colspan="4" class="text-muted p-3">Yükleniyor…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/transfer/transfer-home.js"></script>
}
