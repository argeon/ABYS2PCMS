@page "/migrate/cs-reading-plan"
@model MigrationWeb.Pages.Migrate.CsReadingPlanModel
@{
    ViewData["Title"] = "CS_READING_PLAN Aktarımı";
}

<link href="~/css/wizard.css" rel="stylesheet" />

<div class="wizard-container cs-reading-plan-page">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <h2 class="mb-1">SMS.CS_READING_PLAN</h2>
            <p class="text-muted mb-0">
                Oracle kaynak tablosundan MSSQL hedefe C# Migration Engine ile aktarım.
                <code>LOCATION</code> kolonu <strong>geography (WGS84 / EPSG:4326)</strong> olarak dönüştürülür.
            </p>
        </div>
        <a href="/" class="btn btn-outline-secondary btn-sm">Panele dön</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Kaynak (Oracle)</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Host</label>
                        <input type="text" class="form-control" id="oracleHost" placeholder="localhost" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Port</label>
                            <input type="text" class="form-control" id="oraclePort" value="1521" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Service / SID</label>
                            <input type="text" class="form-control" id="oracleService" placeholder="ORCL" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kullanıcı</label>
                        <input type="text" class="form-control" id="oracleUser" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password" class="form-control" id="oraclePassword" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şema</label>
                        <input type="text" class="form-control" id="oracleSchema" value="SMS" />
                    </div>
                    <button type="button" class="btn btn-outline-info btn-sm" id="btnTestOracle">Bağlantıyı test et</button>
                    <span id="oracleTestStatus" class="small ms-2 text-muted"></span>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Hedef (MSSQL)</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Sunucu</label>
                        <input type="text" class="form-control" id="mssqlServer" placeholder="localhost" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Veritabanı</label>
                        <input type="text" class="form-control" id="mssqlDatabase" placeholder="izgazMGR" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kullanıcı</label>
                        <input type="text" class="form-control" id="mssqlUser" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password" class="form-control" id="mssqlPassword" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hedef tablo</label>
                        <input type="text" class="form-control" value="CS_READING_PLAN" readonly disabled />
                        <div class="form-text">Kaynak ile aynı tablo adı kullanılır.</div>
                    </div>
                    <button type="button" class="btn btn-outline-info btn-sm" id="btnTestMssql">Bağlantıyı test et</button>
                    <span id="mssqlTestStatus" class="small ms-2 text-muted"></span>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card mb-4 border-info">
                <div class="card-body">
                    <h5 class="text-info">LOCATION — WGS84 aktarımı</h5>
                    <p class="small text-muted mb-2">
                        Oracle <code>SDO_GEOMETRY</code> kolonu C# motorunda şu akışla işlenir:
                    </p>
                    <ol class="small mb-0">
                        <li>Oracle: <code>SDO_UTIL.TO_WKTGEOMETRY</code></li>
                        <li>Staging: <code>NVARCHAR(MAX)</code> (WKT)</li>
                        <li>MSSQL: <code>geography::STGeomFromText(..., 4326)</code></li>
                    </ol>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Aktarım seçenekleri</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Paralellik</label>
                            <input type="number" class="form-control" id="degreeOfParallelism" value="4" min="1" max="32" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Batch boyutu</label>
                            <input type="number" class="form-control" id="batchSize" value="50000" min="1000" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fetch (MB)</label>
                            <input type="number" class="form-control" id="fetchSizeMB" value="50" min="1" />
                        </div>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="migratePrimaryKeys" checked />
                        <label class="form-check-label" for="migratePrimaryKeys">Primary key oluştur</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="migrateForeignKeys" />
                        <label class="form-check-label" for="migrateForeignKeys">Foreign key oluştur</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="migrateIndexes" />
                        <label class="form-check-label" for="migrateIndexes">Index oluştur</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="hardReset" checked />
                        <label class="form-check-label" for="hardReset">Hedef tabloyu sil ve yeniden oluştur (Hard reset)</label>
                        <div class="form-text">LOCATION kolonu eksikse veya şema değiştiyse bu seçenek açık olmalıdır.</div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Önizleme</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPreview">Şemayı yükle</button>
                </div>
                <div class="card-body p-0">
                    <div id="previewSummary" class="p-3 small text-muted">Bağlantıları girip önizleme yükleyin.</div>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Kolon</th>
                                    <th>Oracle tipi</th>
                                    <th>MSSQL hedef</th>
                                    <th>Null</th>
                                </tr>
                            </thead>
                            <tbody id="previewColumns">
                                <tr><td colspan="4" class="text-muted p-3">—</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mb-4">
                <button type="button" class="btn btn-secondary" id="btnSave">Tanımı kaydet</button>
                <button type="button" class="btn btn-primary" id="btnStart">Aktarımı başlat</button>
                <button type="button" class="btn btn-warning" id="btnResume">Kaldığı yerden devam</button>
            </div>

            <div class="card">
                <div class="card-header">Durum</div>
                <div class="card-body">
                    <div id="statusMessage" class="small text-muted">Henüz aktarım başlatılmadı.</div>
                    <div class="mt-2">
                        <a href="/" class="btn btn-sm btn-outline-primary">Canlı panelde izle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/migrate/cs-reading-plan.js"></script>
}
