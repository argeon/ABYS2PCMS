@page
@model StartModel
@{
    ViewData["Title"] = "Start Migration";
}

<div class="container" style="max-width: 900px; margin-top: 3rem;">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                <svg width="24" height="24" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                </svg>
                Configuration Saved Successfully
            </h4>
        </div>
        <div class="card-body">
            <div class="alert alert-success">
                <strong>Step 1 Complete!</strong> Your migration configuration has been saved.
            </div>

            <h5>Next Steps:</h5>
            
            <div class="step-instructions">
                <div class="step-number">1</div>
                <div class="step-content">
                    <h6>Open a new terminal/command prompt</h6>
                    <p>Open a separate terminal window (keep this browser window open)</p>
                </div>
            </div>

            <div class="step-instructions">
                <div class="step-number">2</div>
                <div class="step-content">
                    <h6>Navigate to MigrationEngine directory</h6>
                    <div class="code-block">
                        <code>cd @Model.EnginePath</code>
                        <button class="btn btn-sm btn-outline-primary copy-btn" onclick="copyToClipboard('cd @Model.EnginePath')">
                            <svg width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16">
                                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                            </svg>
                            Copy
                        </button>
                    </div>
                </div>
            </div>

            <div class="step-instructions">
                <div class="step-number">3</div>
                <div class="step-content">
                    <h6>Start the Migration Engine</h6>
                    <p class="small text-muted mb-2">If you left &quot;Auto-start on <code>dotnet run</code>&quot; <strong>off</strong> in the wizard, use the command below (or click <strong>Start Engine Now</strong> on this page).</p>
                    <div class="code-block">
                        <code>dotnet run -- --run</code>
                        <button class="btn btn-sm btn-outline-primary copy-btn" onclick="copyToClipboard('dotnet run -- --run')">
                            <svg width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16">
                                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                            </svg>
                            Copy
                        </button>
                    </div>
                    <small class="text-muted">With <code>--run</code>, the migration runs once. If <code>Migration:AutoStart</code> is true in appsettings, plain <code>dotnet run</code> also starts migration.</small>
                </div>
            </div>

            <div class="step-instructions">
                <div class="step-number">4</div>
                <div class="step-content">
                    <h6>Monitor progress on the Dashboard</h6>
                    <p>Return to this browser window and click the button below to see real-time progress</p>
                </div>
            </div>

            <hr class="my-4">

            <div class="text-center">
                <h5 class="mb-3">Quick Actions</h5>
                <button class="btn btn-success btn-lg me-3" id="autoStartEngineBtn" onclick="autoStartEngine()">
                    <i class="fas fa-rocket"></i> Start Engine Now
                </button>
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="fas fa-chart-line"></i> Go to Dashboard
                </a>
            </div>

            <div class="alert alert-warning mt-4">
                <strong>Important Notes:</strong>
                <ul class="mb-0">
                    <li>The migration engine must remain running during the entire process</li>
                    <li>Do not close the console window while migration is in progress</li>
                    <li>You can monitor progress in real-time on the Dashboard</li>
                    <li>Configuration file saved at: <code>@Model.ConfigPath</code></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
.step-instructions {
    display: flex;
    align-items: flex-start;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--bg-tertiary);
    border-radius: 8px;
}

.step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-blue);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-right: 1rem;
}

.step-content {
    flex: 1;
}

.step-content h6 {
    color: var(--accent-blue);
    margin-bottom: 0.5rem;
}

.code-block {
    background: var(--bg-dark);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.75rem;
    margin: 0.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.code-block code {
    color: var(--accent-green);
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 0.9rem;
}

.copy-btn {
    margin-left: 1rem;
    white-space: nowrap;
}
</style>

@section Scripts {
<script>
async function autoStartEngine() {
    const btn = document.getElementById('autoStartEngineBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Derleniyor…';

    const swalOk = typeof Swal !== 'undefined';

    try {
        const buildResponse = await fetch('/api/engine/build', { method: 'POST' });
        const buildResult = await buildResponse.json();

        if (!buildResult.success) {
            throw new Error('Build başarısız: ' + buildResult.error);
        }

        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Başlatılıyor…';

        const response = await fetch('/api/engine/start', { method: 'POST' });
        const data = await response.json();

        if (data.success) {
            btn.innerHTML = '<i class="fas fa-check"></i> Motor çalışıyor';
            btn.className = 'btn btn-success btn-lg me-3';
            if (swalOk) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Migration Engine başlatıldı',
                    text: 'Panele yönlendiriliyorsunuz…',
                    timer: 1400,
                    showConfirmButton: false,
                    background: '#212529',
                    color: '#f8f9fa',
                });
            }
            window.location.href = '/';
        } else {
            throw new Error(data.error || 'Motor başlatılamadı');
        }
    } catch (error) {
        if (swalOk) {
            await Swal.fire({
                icon: 'error',
                title: 'Motor başlatılamadı',
                text: error.message,
                confirmButtonText: 'Tamam',
                background: '#212529',
                color: '#f8f9fa',
            });
        } else {
            window.alert('Hata: ' + error.message);
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-rocket"></i> Motoru şimdi başlat';
    }
}

function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function () {
        const btn = event.target.closest('button');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<svg width="16" height="16" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/></svg> Kopyalandı!';
        setTimeout(() => {
            btn.innerHTML = originalHtml;
        }, 2000);
    });
}
</script>
}
