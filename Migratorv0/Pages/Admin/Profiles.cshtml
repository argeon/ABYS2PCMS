@page "/admin/profiles"
@model MigrationWeb.Pages.Admin.ProfilesModel
@{
    ViewData["Title"] = "SQLite Profiller";
}

<style>
    .admin-profiles .table td { vertical-align: middle; }
    .admin-profiles .deleted-row { opacity: 0.65; }
    .admin-profiles #configJsonEditor {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85rem;
        min-height: 220px;
    }
    .admin-profiles .badge-wizard { background: #0d6efd; }
    .admin-profiles .badge-oracle { background: #c0392b; }
    .admin-profiles .badge-mssql { background: #198754; }
</style>

<div class="admin-profiles container-fluid px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h4 class="mb-1">SQLite — Bağlantı profilleri &amp; wizard kayıtları</h4>
            <p class="text-muted small mb-0">
                <code>connection_profiles</code> tablosu. Güncelleme ve soft delete desteklenir.
            </p>
        </div>
        <button type="button" class="btn btn-outline-light btn-sm" id="btnRefreshProfiles">Yenile</button>
    </div>

    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="filterSearch">Ara</label>
                    <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Ad, host, schema…">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="filterType">Tür</label>
                    <select id="filterType" class="form-select form-select-sm">
                        <option value="">Tümü</option>
                        <option value="wizard">Wizard / Migration</option>
                        <option value="Oracle">Oracle</option>
                        <option value="MSSQL">MSSQL</option>
                        <option value="Migration">Migration</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="filterDeleted">Durum</label>
                    <select id="filterDeleted" class="form-select form-select-sm">
                        <option value="active">Aktif</option>
                        <option value="deleted">Silinmiş</option>
                        <option value="all">Hepsi</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Kayıtlar</span>
                    <span class="badge text-bg-secondary" id="profileCount">0</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 70vh;">
                        <table class="table table-dark table-hover table-sm mb-0">
                            <thead class="sticky-top" style="background: #212529;">
                                <tr>
                                    <th>ID</th>
                                    <th>Ad</th>
                                    <th>Tür</th>
                                    <th>Hedef</th>
                                    <th>Kullanım</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="profilesTableBody">
                                <tr><td colspan="6" class="text-muted p-3">Yükleniyor…</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="formTitle">Profil düzenle</span>
                    <span class="badge text-bg-secondary d-none" id="formDeletedBadge">Silinmiş</span>
                </div>
                <div class="card-body">
                    <form id="profileForm" autocomplete="off">
                        <input type="hidden" id="profileId" value="">

                        <div class="mb-2">
                            <label class="form-label small" for="profileName">Profil adı</label>
                            <input type="text" class="form-control form-control-sm" id="profileName" required>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small" for="connectionType">Tür</label>
                                <select class="form-select form-select-sm" id="connectionType">
                                    <option value="Oracle">Oracle</option>
                                    <option value="MSSQL">MSSQL</option>
                                    <option value="Migration">Migration (Wizard)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small" for="authType">Auth</label>
                                <input type="text" class="form-control form-control-sm" id="authType" placeholder="SqlPassword / Windows…">
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-8">
                                <label class="form-label small" for="host">Host</label>
                                <input type="text" class="form-control form-control-sm" id="host">
                            </div>
                            <div class="col-4">
                                <label class="form-label small" for="port">Port</label>
                                <input type="text" class="form-control form-control-sm" id="port">
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small" for="serviceName">Service name</label>
                                <input type="text" class="form-control form-control-sm" id="serviceName">
                            </div>
                            <div class="col-6">
                                <label class="form-label small" for="databaseName">Database</label>
                                <input type="text" class="form-control form-control-sm" id="databaseName">
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small" for="username">Username</label>
                                <input type="text" class="form-control form-control-sm" id="username">
                            </div>
                            <div class="col-6">
                                <label class="form-label small" for="schemaName">Schema</label>
                                <input type="text" class="form-control form-control-sm" id="schemaName">
                            </div>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="trustCert">
                            <label class="form-check-label small" for="trustCert">Trust server certificate</label>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small" for="connectionString">Connection string</label>
                            <textarea class="form-control form-control-sm" id="connectionString" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label small mb-0" for="configJsonEditor">Wizard / Migration config JSON</label>
                                <button type="button" class="btn btn-link btn-sm p-0" id="btnFormatJson">Formatla</button>
                            </div>
                            <textarea class="form-control form-control-sm" id="configJsonEditor" spellcheck="false"></textarea>
                            <div class="form-text">Migration wizard kayıtlarının tam ayarı burada tutulur.</div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary btn-sm" id="btnSaveProfile">Kaydet</button>
                            <button type="button" class="btn btn-outline-warning btn-sm" id="btnSoftDelete">Soft delete</button>
                            <button type="button" class="btn btn-outline-success btn-sm d-none" id="btnRestore">Geri al</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearForm">Temizle</button>
                        </div>
                    </form>

                    <div class="text-muted small mt-3" id="formMeta"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-profiles.js"></script>
}
