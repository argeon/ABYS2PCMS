        M2[NVARCHAR]
        M3[DATETIME2]
        M4[DATETIME2/DATETIMEOFFSET]
        M5[NVARCHAR MAX/<br/>VARBINARY MAX]
        M6[SKIP Column<br/>+ Warning]
    end
    
    O1 --> Analyze
    O2 --> Analyze
    O3 --> Analyze
    O4 --> Analyze
    O5 --> Analyze
    O6 --> Analyze
    
    Analyze --> Rules
    Rules --> Warning
    
    Warning -->|NUMBER p,s| M1
    Warning -->|VARCHAR2| M2
    Warning -->|DATE warning| M3
    Warning -->|TIMESTAMP| M4
    Warning -->|CLOB/BLOB| M5
    Warning -->|ROWID warning| M6
    
    style TypeMapper fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style Oracle fill:#f96,stroke:#333,stroke-width:2px
    style MSSQL fill:#6cf,stroke:#333,stroke-width:2px
            </div>
            
