@page "/wizard-mssql"
@model WizardMssqlModel
@{
    ViewData["Title"] = "MSSQL Copy Wizard";
}

<div class="wizard-container">
    <div id="resumeBanner" class="d-none mb-4">
        <div class="card border-warning">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3">
                    <i class="fas fa-exclamation-triangle text-warning fa-2x flex-shrink-0 mt-1"></i>
                    <div class="flex-grow-1">
                        <h5 class="mb-1">Yarıda kalan MSSQL kopyalama bulundu</h5>
                        <p class="mb-2 text-muted" id="resumeSummaryText"></p>
                        <div id="resumeTableList" class="mb-3 small"></div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-warning btn-sm" onclick="startResume()">
                                <i class="fas fa-play me-1"></i> Kaldığı Yerden Devam Et
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="dismissResumeBanner()">
                                <i class="fas fa-plus me-1"></i> Yeni Kopyalama Başlat
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="wizardProfileBanner" class="card border-info mb-4 d-none">
        <div class="card-body py-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="fas fa-bookmark text-info"></i>
                <strong class="small">Kayıtlı MSSQL Copy profili yükle</strong>
                <select class="form-select form-select-sm flex-shrink-1" style="max-width:360px" id="wizardProfileSelect">
                    <option value="">-- Profil seç --</option>
                </select>
                <button type="button" class="btn btn-sm btn-info flex-shrink-0" id="wizardProfileLoadBtn">
                    <i class="fas fa-download me-1"></i>Yükle
                </button>
            </div>
            <div id="wizardProfileLoadStatus" class="small text-muted mt-2"></div>
        </div>
    </div>

    <div class="wizard-progress">
        <div class="step active" data-step="1">
            <div class="step-number">1</div>
            <div class="step-label">Source MSSQL</div>
        </div>
        <div class="step" data-step="2">
            <div class="step-number">2</div>
            <div class="step-label">Target MSSQL</div>
        </div>
        <div class="step" data-step="3">
            <div class="step-number">3</div>
            <div class="step-label">Select Tables</div>
        </div>
        <div class="step" data-step="4">
            <div class="step-number">4</div>
            <div class="step-label">Configure & Start</div>
        </div>
    </div>

    <!-- Step 1: Source -->
    <div class="wizard-step active" id="step1">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-database me-2"></i>Source SQL Server Connection</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>Source:</strong> Tables will be read from this SQL Server database.
                </div>
                <form id="sourceForm">
                    <div class="mb-3">
                        <label class="form-label">Server</label>
                        <input type="text" class="form-control" id="sourceServer" placeholder="localhost or SERVER\INSTANCE" value="localhost">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Authentication</label>
                        <select class="form-select" id="sourceAuth">
                            <option value="sql">SQL Server Authentication</option>
                            <option value="windows">Windows Authentication</option>
                        </select>
                    </div>
                    <div id="sourceCredentials">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Username</label>
                                <input type="text" class="form-control" id="sourceUser" placeholder="sa">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" id="sourcePassword" placeholder="Password">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Database Name</label>
                        <input type="text" class="form-control" id="sourceDatabase" placeholder="SourceDB">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Schema</label>
                        <input type="text" class="form-control" id="sourceSchema" placeholder="dbo" value="dbo">
                        <small class="form-text text-muted">Tables will be listed from this schema</small>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="sourceTrustCert" checked>
                        <label class="form-check-label" for="sourceTrustCert">Trust Server Certificate</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" id="testSourceBtn">
                            <span class="spinner-border spinner-border-sm d-none" id="sourceSpinner"></span>
                            Test Connection
                        </button>
                        <div id="sourceResult" class="d-none"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Step 2: Target -->
    <div class="wizard-step" id="step2">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-server me-2"></i>Target SQL Server Connection</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>Target:</strong> Data and schema will be written to this SQL Server database.
                </div>
                <form id="targetForm">
                    <div class="mb-3">
                        <label class="form-label">Server</label>
                        <input type="text" class="form-control" id="targetServer" placeholder="localhost or SERVER\INSTANCE" value="localhost">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Authentication</label>
                        <select class="form-select" id="targetAuth">
                            <option value="sql">SQL Server Authentication</option>
                            <option value="windows">Windows Authentication</option>
                        </select>
                    </div>
                    <div id="targetCredentials">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Username</label>
                                <input type="text" class="form-control" id="targetUser" placeholder="sa">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" id="targetPassword" placeholder="Password">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Database Name</label>
                        <input type="text" class="form-control" id="targetDatabase" placeholder="TargetDB">
                        <small class="form-text text-muted">Database must already exist</small>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="targetTrustCert" checked>
                        <label class="form-check-label" for="targetTrustCert">Trust Server Certificate</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" id="testTargetBtn">
                            <span class="spinner-border spinner-border-sm d-none" id="targetSpinner"></span>
                            Test Connection
                        </button>
                        <div id="targetResult" class="d-none"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Step 3 -->
    <div class="wizard-step" id="step3">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-list-check me-2"></i>Select Tables to Copy</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" id="loadingTables">
                    <span class="spinner-border spinner-border-sm"></span>
                    Loading tables from source SQL Server...
                </div>
                <div id="tableSelection" class="d-none">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div class="flex-grow-1" style="min-width:220px;max-width:420px">
                            <input type="text" class="form-control" id="tableSearch" placeholder="Ara: tablo / view adı (LS_…)">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-primary" id="selectAllBtn" title="Filtrelenenlerin tümünü seç">Select filtered</button>
                            <button class="btn btn-sm btn-outline-secondary" id="deselectAllBtn">Deselect filtered</button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="includeViewsChk" checked>
                            <label class="form-check-label small" for="includeViewsChk">View'leri listele</label>
                        </div>
                        <span class="small text-muted" id="catalogMeta"></span>
                    </div>
                    <div class="table-list" id="tableList"></div>
                    <div class="mt-3">
                        <strong>Selected: <span id="selectedCount">0</span></strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Retry Modal -->
    <div class="modal fade" id="retryModeModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Yeniden Aktarım Modu</h5>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">Aşağıdaki tablolar hedefte veri içeriyor veya önceki bir aktarımda kullanıldı.</p>
                    <table class="table table-dark table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Tablo</th>
                                <th>Durum</th>
                                <th style="min-width:340px">Aktarım Modu</th>
                            </tr>
                        </thead>
                        <tbody id="retryModeTableBody"></tbody>
                    </table>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" id="retryModalCancelBtn">İptal</button>
                    <button type="button" class="btn btn-primary" id="retryModalConfirmBtn">Devam Et</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 4 -->
    <div class="wizard-step" id="step4">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-gear me-2"></i>Copy Configuration</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Degree of Parallelism</label>
                        <input type="number" class="form-control" id="parallelism" value="8" min="1" max="64">
                        <small class="form-text text-muted">Paralel tablo/view worker (1–64)</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Batch Size</label>
                        <input type="number" class="form-control" id="batchSize" value="50000" min="1000" max="100000" step="1000">
                    </div>
                </div>

                <hr class="my-4">
                <h6 class="text-secondary fw-semibold small text-uppercase mb-2">Validation</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Validation Mode</label>
                        <select class="form-select" id="validationMode">
                            <option value="CountOnly" selected>CountOnly</option>
                            <option value="Balanced">Balanced</option>
                            <option value="Strict">Strict</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="validatePerTableAfterLoad" checked>
                            <label class="form-check-label" for="validatePerTableAfterLoad">Validate after each table</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="validationFailFast">
                            <label class="form-check-label" for="validationFailFast">Fail-fast</label>
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary py-2 mb-0">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="autoStartDotnetRun">
                        <label class="form-check-label" for="autoStartDotnetRun">
                            Auto-start on <code>dotnet run</code> (without <code>--run</code>)
                        </label>
                    </div>
                </div>

                <hr class="my-4">
                <h5 class="mb-3"><i class="fas fa-cog"></i> Schema Options</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="migratePrimaryKeys" checked>
                            <label class="form-check-label" for="migratePrimaryKeys"><strong>Primary Keys</strong></label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="migrateIndexes">
                            <label class="form-check-label" for="migrateIndexes"><strong>Indexes</strong></label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="migrateForeignKeys">
                            <label class="form-check-label" for="migrateForeignKeys"><strong>Foreign Keys</strong></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="migrateUniqueConstraints">
                            <label class="form-check-label" for="migrateUniqueConstraints"><strong>Unique Constraints</strong></label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="migrateCheckConstraints">
                            <label class="form-check-label" for="migrateCheckConstraints"><strong>Check Constraints</strong></label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="migrateTriggers" disabled>
                            <label class="form-check-label" for="migrateTriggers"><strong>Triggers</strong> <small class="text-muted">(not in v1)</small></label>
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                <h5>Copy Summary</h5>
                <div class="summary-box">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Source:</strong></p>
                            <p class="text-muted" id="summarySource">-</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Target:</strong></p>
                            <p class="text-muted" id="summaryTarget">-</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <p><strong>Tables:</strong></p>
                            <p class="text-muted" id="summaryTables">-</p>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Seçili tablolar: kaynak/hedef kontrolü</h6>
                        <button type="button" class="btn btn-sm btn-outline-info" id="checkTableStatusBtn">Kontrol et</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Tablo</th>
                                    <th>Checkpoint</th>
                                    <th class="text-end">Kaynak</th>
                                    <th class="text-end">Hedef</th>
                                    <th>Eşleşme</th>
                                </tr>
                            </thead>
                            <tbody id="tableTransferStatusBody">
                                <tr><td colspan="5" class="text-muted text-center py-3">Kontrol için "Kontrol et" butonunu kullanın.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr class="my-4">
                <h5 class="mb-3"><i class="fas fa-bookmark me-1"></i> Profil kaydet</h5>
                <div class="row g-2 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label" for="migrationProfileName">Profil adı</label>
                        <input type="text" class="form-control" id="migrationProfileName" placeholder="örn. Stage → Prod copy">
                    </div>
                    <div class="col-md-5">
                        <button type="button" class="btn btn-outline-primary w-100" id="saveMigrationProfileBtn" onclick="saveMigrationProfile()">
                            <i class="fas fa-save me-1"></i> Profili Kaydet
                        </button>
                    </div>
                </div>
                <div id="saveProfileResult" class="mt-2"></div>
            </div>
        </div>
    </div>

    <div class="wizard-navigation">
        <button class="btn btn-secondary" id="prevBtn" disabled>Previous</button>
        <button class="btn btn-primary" id="nextBtn">Next</button>
        <button class="btn btn-success d-none" id="startBtn">Kaydet ve devam</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/wizard-mssql.js"></script>
}
