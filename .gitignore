## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Migration-specific
*.db
*.db-shm
*.db-wal
logs/
migration_checkpoint.db

# Local publish / verify artifacts
publish/
_build_verify/

# SQL tree backups (local snapshots)
sql/IZGAZ2PCMS/IZGAZ2PCMS_backup_*/
sql/IZGAZ2PCMS/IZGAZ2PCMS_sql_backup_*/

# Secrets / connection profiles (use *.example.json locally)
MigrationEngine/appsettings.json
sql/IZGAZ2PCMS/IZGAZ2PCMS/connections.json
sql/IZGAZ2PCMS/IZGAZ2PCMS/stage_ops/stage_ops.config.json

# Keep prodEnergy log folder scaffolding (runtime *.log still ignored)
!sql/IZGAZ2PCMS/IZGAZ2PCMS/prodEnergy/logs/
!sql/IZGAZ2PCMS/IZGAZ2PCMS/prodEnergy/logs/**
sql/IZGAZ2PCMS/IZGAZ2PCMS/prodEnergy/logs/**/*.log
sql/IZGAZ2PCMS/IZGAZ2PCMS/prodEnergy/logs/**/*.timing.txt

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Azure
*.pubxml
*.PublishSettings

# Others
*.cache
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# JetBrains Rider
.idea/
*.sln.iml

# Stage Ops secrets
sql/IZGAZ2PCMS/IZGAZ2PCMS/stage_ops/stage_ops.connections.json
sql/IZGAZ2PCMS/IZGAZ2PCMS/stage_ops/logs/
sql/IZGAZ2PCMS/IZGAZ2PCMS/stage_ops/artifacts/

